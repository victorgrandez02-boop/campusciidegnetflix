# ============================================
# .env.example — Variables de Entorno
# Campus Virtual CIIDEG
# ============================================
# INSTRUCCIONES:
#   1. Copia este archivo como ".env"
#   2. Rellena TODOS los valores antes de levantar el sistema
#   3. NUNCA subas .env a git (ya está en .gitignore)
# ============================================

# ============================================
# ENTORNO DE APLICACIÓN
# ============================================
# Valores: development | production
APP_ENV=production

# ============================================
# SEGURIDAD — CORS
# ============================================
# Origen del frontend en producción (ej: https://campus.ciideg.edu.pe)
# Para desarrollo local: http://localhost:3000
CORS_ALLOWED_ORIGIN=https://campus.ciideg.edu.pe

# ============================================
# PostgreSQL — Base de Datos Principal
# ============================================
# IMPORTANTE: usar contraseñas fuertes (mínimo 20 caracteres) en producción
POSTGRES_DB=campus_virtual
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_FUERTE_AQUI
POSTGRES_PORT=5432

# ============================================
# API PHP — Conexión interna a PostgreSQL
# ============================================
DB_TYPE=postgresql
PG_HOST=postgres
PG_PORT=5432
PG_DB_NAME=campus_virtual
PG_USERNAME=campus_user
PG_PASSWORD=CAMBIAR_CONTRASENA_FUERTE_AQUI

# ============================================
# Puertos de servicios (Docker)
# ============================================
API_PORT=8080
FRONTEND_PORT=3000

# ============================================
# Frontend -> API
# ============================================
# En Docker produccion, Nginx publica la API en el mismo origen bajo /api.
# Para forzar almacenamiento local en un build de prueba: VITE_USE_LOCAL_STORE=true
VITE_API_BASE_URL=/api
VITE_USE_LOCAL_STORE=false
VITE_API_PROXY_TARGET=http://localhost:8080

# ============================================
# pgAdmin — Solo para entornos de desarrollo/staging
# IMPORTANTE: No exponer pgAdmin en producción al público
# ============================================
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@campus.ciideg.edu.pe
PGADMIN_PASSWORD=CAMBIAR_CONTRASENA_PGADMIN_AQUI
