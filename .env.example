# ==============================================================================
# .env.example — Archivo de Configuración de Variables de Entorno
# Campus Virtual CIIDEG
# Instrucciones: Copie este archivo como '.env' y configure las credenciales reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO Y SEGURIDAD
# ------------------------------------------------------------------------------

# Define el modo de ejecución del servidor: 'development' o 'production'
# En 'production', se ocultan detalles internos de excepciones en las respuestas JSON de la API.
APP_ENV=production

# Origen permitido para peticiones CORS. Debe coincidir exactamente con el dominio de su frontend.
# Por seguridad en producción, evite utilizar '*'.
CORS_ALLOWED_ORIGIN=https://campus.ciideg.edu.pe

# Clave secreta para firmar tokens JWT. Debe cambiarse en cada despliegue de producción.
# Se recomienda una cadena compleja y aleatoria de al menos 64 caracteres.
APP_SECRET=CAMBIAR_SECRETO_ALEATORIO_DE_64_CARACTERES_PRODUCCION

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DE BASE DE DATOS (POSTGRESQL)
# ------------------------------------------------------------------------------

# Configuración interna para el contenedor oficial de PostgreSQL (Docker)
POSTGRES_DB=campus_virtual
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_FUERTE_POSTGRES_AQUI
POSTGRES_PORT=5432

# Parámetros de conexión que utiliza el código del backend PHP (api/config.php)
DB_TYPE=postgresql
PG_HOST=postgres
PG_PORT=5432
PG_DB_NAME=campus_virtual
PG_USERNAME=campus_user
PG_PASSWORD=CAMBIAR_CONTRASENA_FUERTE_POSTGRES_AQUI

# ------------------------------------------------------------------------------
# 3. PUERTOS DE EXPOSICIÓN LOCAL (DOCKER / DESARROLLO)
# ------------------------------------------------------------------------------

# Puertos que mapea docker-compose hacia el host.
# NOTA: En producción se recomienda desexponer POSTGRES_PORT y PGADMIN_PORT del host.
API_PORT=8080
FRONTEND_PORT=3000
PGADMIN_PORT=5050

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN FRONTEND (REACT / VITE)
# ------------------------------------------------------------------------------

# URL base para los endpoints de la API consumidos por el cliente
VITE_API_BASE_URL=/api

# MODO DEMO OFFLINE (Muy Importante):
# - true: El frontend no consume la API PHP y opera de forma simulada en 'localStorage' (Modo Demo).
# - false: El frontend consume la API real PHP y persiste los datos en PostgreSQL.
VITE_USE_LOCAL_STORE=false

# URL del proxy de desarrollo utilizado por el dev server de Vite (vite.config.ts)
VITE_API_PROXY_TARGET=http://localhost:8080

# Contraseñas temporales utilizadas por los scripts de inicialización / Modo Demo
VITE_DEMO_ADMIN_PASSWORD=@26Gemses1
VITE_DEMO_GESTOR_PASSWORD=@26Gemses1
VITE_DEMO_DOCENTE_PASSWORD=@26Gemses1
VITE_DEMO_STUDENT_PASSWORD=@26Gemses1

# ------------------------------------------------------------------------------
# 5. CONFIGURACIÓN DE PGADMIN (OPCIONAL)
# ------------------------------------------------------------------------------

# Credenciales de inicio de sesión para el panel web de administración de pgAdmin
PGADMIN_EMAIL=admin@campus.ciideg.edu.pe
PGADMIN_PASSWORD=CAMBIAR_CONTRASENA_ACCESO_PGADMIN_AQUI
